# =============================================================================
# n8n-hubspot-sales-rep-activity-quota-scoreboard — environment template
# Set these on the n8n host/container (read through $env). Never commit real values.
# Values that still start with YOUR_ are treated as "not set".
# License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true = build the scoreboard and show it in n8n, but post nothing to Slack.
# Anything other than an explicit "false" keeps it on.
DRY_RUN=true

# --- HubSpot (read-only) ------------------------------------------------------
# Private App access token. Scopes: crm.objects.owners.read, crm.objects.contacts.read
# (calls + meetings search) and sales-email-read (emails; without it email owners are redacted).
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Slack ----------------------------------------------------------------------
# One or more Slack incoming webhook URLs, comma-separated (max 10), one per channel.
SLACK_WEBHOOK_URLS=YOUR_SLACK_WEBHOOK_URL
# Optional Slack-compatible webhook for masked error alerts (e.g. an ops channel).
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL
SCOREBOARD_TITLE=Sales activity scoreboard

# --- Reporting window -----------------------------------------------------------
# previous_business_day | yesterday | today | last_week | week_to_date | month_to_date
REPORT_WINDOW=previous_business_day
# IANA time zone that defines "day" boundaries, e.g. America/New_York, Europe/London, Asia/Dhaka.
REPORT_TIMEZONE=UTC
# false = Saturdays/Sundays carry no quota and are skipped by previous_business_day.
COUNT_WEEKENDS=false

# --- Which reps -----------------------------------------------------------------
# Leave all empty to score every owner with activity. Numeric HubSpot owner/team IDs only.
REP_OWNER_IDS=
REP_TEAM_IDS=
EXCLUDE_OWNER_IDS=
# true = reps in REP_OWNER_IDS / REP_TEAM_IDS appear even with zero activity.
INCLUDE_ZERO_ACTIVITY_REPS=true
# full | first_last_initial | initials  (owner emails are never shown in Slack)
NAME_FORMAT=first_last_initial
MAX_REPS_SHOWN=20

# --- Quotas (per working day; multiplied by working days in the window) --------
DAILY_TARGET_CALLS=30
DAILY_TARGET_EMAILS=40
DAILY_TARGET_MEETINGS=2
# Optional per-rep overrides keyed by owner ID or owner email, e.g.
# QUOTA_OVERRIDES_JSON={"10000001":{"calls":40},"rep_1@example.com":{"meetings":3}}
QUOTA_OVERRIDES_JSON=

# --- Scoring --------------------------------------------------------------------
# Weighted quota attainment (each type capped at ATTAINMENT_CAP, e.g. 1.5 = 150%).
WEIGHT_CALLS=0.3
WEIGHT_EMAILS=0.2
WEIGHT_MEETINGS=0.5
ATTAINMENT_CAP=1.5
# Activity points (tie-breaker and optional ranking field).
POINTS_CALL=1
POINTS_CONNECTED_CALL=2
POINTS_EMAIL=0.5
POINTS_MEETING=5
# A call of at least this many seconds counts as "connected".
CONNECTED_CALL_MIN_SECONDS=60
# booked = meetings created in the window · held = meetings starting in the window
MEETING_COUNT_MODE=booked
# attainment | points | meetings | calls | emails
RANK_BY=attainment

# --- n8n instance (set on the host, not in the workflow) ------------------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# GENERIC_TIMEZONE=UTC
